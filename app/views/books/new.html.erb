<h1>New Book</h1>

<%= form_with model: @book do |form| %>
  <% if @book.errors.any? %>
    <div>
      <h2>Errors:</h2>

      <ul>
        <% @book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :author %>
    <%= form.text_field :author %>
  </div>

  <%= form.submit %>
<% end %>

<%= link_to "Back to Books", books_path %>